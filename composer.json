{
	"name": "flarum-lang/ukrainian",
	"description": "Ukrainian Language Pack for Flarum",
	"type": "flarum-extension",
	"keywords": [
		"flarum-locale"
	],
	"homepage": "https://github.com/flarum-lang/ukrainian",
	"license": "MIT",
	"authors": [
		{
			"name": "denysdesign",
			"homepage": "https://github.com/denysdesign",
			"role": "Maintainer"
		}
	],
	"support": {
		"issues": "https://github.com/flarum-lang/ukrainian/issues",
		"forum": "https://discuss.flarum.org/d/31921",
		"source": "https://github.com/flarum-lang/ukrainian"
	},
	"require": {
		"flarum/core": "^1.3"
	},
	"extra": {
		"branch-alias": {
			"dev-master": "1.x-dev"
		},
		"flarum-extension": {
			"title": "Ukrainian",
			"category": "language",
			"icon": {
				"image": "icon.svg",
				"backgroundSize": "cover",
				"backgroundPosition": "center"
			}
		},
		"flarum-locale": {
			"code": "uk",
			"title": "Українська"
		}
	}
}
